{
    "name": "@glideapps/glide-data-grid-spreadsheet",
    "version": "0.1.0",
    "description": "Optional lightweight spreadsheet model and formula engine for Glide Data Grid",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "benchmark": "npm run build && node bench/performance.mjs",
        "lint": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@glideapps/glide-data-grid": "6.0.4-alpha25"
    },
    "peerDependencies": {
        "react": "^16.12.0 || 17.x || 18.x || 19.x",
        "react-dom": "^16.9.0 || 17.x || 18.x || 19.x"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.0.0",
        "vitest": "^0.34.6"
    }
}
